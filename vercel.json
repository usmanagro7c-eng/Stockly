{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "VERCEL=1 npm run build",
  "rewrites": [
    { "source": "/(.*\\.(js|css|png|jpg|jpeg|gif|svg|ico|webmanifest|woff|woff2|ttf|eot|map|txt|xml|json))", "destination": "/$1" },
    { "source": "/(.*)", "destination": "/" }
  ]
}
